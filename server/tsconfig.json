{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] },
    "verbatimModuleSyntax": true
  },
  "include": ["src", "../shared", "../src/lib/party", "../src/data"]
}
