# Optional: n8n webhook for the PersonaCore AI career recommendation.
# Leave empty to hide the career section.
# Expected response: { "top_jobs": [{ "title": string, "probability": number, "explanation": string }] }
VITE_N8N_WEBHOOK_URL=

# Optional: Google Apps Script web app (see IQ_LOG_APPS_SCRIPT.gs) that stores
# anonymous Matrix Reasoning responses for item calibration and norms.
# Leave empty to hide the consent checkbox and send nothing.
VITE_IQ_LOG_URL=
